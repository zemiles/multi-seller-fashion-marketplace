Project marketplace {
  database_type: 'PostgreSQL'
  Note: 'Documentation namespaces stand for separate service databases. No cross-service physical FK. CURRENT is migration-derived; PLANNED requires future migrations.'
}

Table settlement.seller_ledger_entry {
  seller_ledger_entry_id "uuid" [not null, pk, note: 'seller_ledger_entry_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  seller_id "uuid" [not null, note: 'seller_id uuid NOT NULL']
  entry_type "text" [not null, note: 'entry_type text NOT NULL']
  signed_amount "bigint" [not null, note: 'signed_amount bigint NOT NULL']
  currency "text" [not null, note: 'currency text NOT NULL']
  source_type "text" [not null, note: 'source_type text NOT NULL']
  source_id "uuid" [null, note: 'source_id uuid']
  source_key "text" [not null, unique, note: 'source_key text NOT NULL']
  reversal_of_entry_id "uuid" [null, note: 'reversal_of_entry_id uuid']
  recognized_at "timestamptz" [not null, note: 'recognized_at timestamptz NOT NULL']
  due_date "date" [not null, note: 'due_date date NOT NULL']
  description "text" [null, note: 'description text']
  metadata "jsonb" [not null, note: 'metadata jsonb NOT NULL DEFAULT \'{}\'::jsonb']
  created_at "timestamptz" [not null, note: 'created_at timestamptz NOT NULL DEFAULT now()']
}

Table settlement.settlement {
  settlement_id "uuid" [not null, pk, note: 'settlement_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  seller_id "uuid" [not null, note: 'seller_id uuid NOT NULL']
  period_start "date" [not null, note: 'period_start date NOT NULL']
  period_end "date" [not null, note: 'period_end date NOT NULL']
  currency "text" [not null, note: 'currency text NOT NULL']
  version_no "integer" [not null, note: 'version_no integer NOT NULL DEFAULT 1']
  status "text" [not null, note: 'status text NOT NULL DEFAULT \'DRAFT\'']
  credit_amount "bigint" [not null, note: 'credit_amount bigint NOT NULL DEFAULT 0']
  debit_amount "bigint" [not null, note: 'debit_amount bigint NOT NULL DEFAULT 0']
  hold_amount "bigint" [not null, note: 'hold_amount bigint NOT NULL DEFAULT 0']
  net_amount "bigint" [not null, note: 'net_amount bigint NOT NULL DEFAULT 0']
  payout_amount "bigint" [not null, note: 'payout_amount bigint NOT NULL DEFAULT 0']
  calculation_version "text" [not null, note: 'calculation_version text NOT NULL']
  calculated_at "timestamptz" [null, note: 'calculated_at timestamptz']
  approved_at "timestamptz" [null, note: 'approved_at timestamptz']
  finalized_at "timestamptz" [null, note: 'finalized_at timestamptz']
  created_at "timestamptz" [not null, note: 'created_at timestamptz NOT NULL DEFAULT now()']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz NOT NULL DEFAULT now()']
  gross_net_amount "bigint" [not null, note: 'PLANNED gross_net_amount bigint NOT NULL']
  indexes {
    (seller_id, period_start, period_end, currency, version_no) [unique]
  }
}

Table settlement.settlement_allocation {
  settlement_allocation_id "uuid" [not null, pk, note: 'settlement_allocation_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  settlement_id "uuid" [not null, note: 'settlement_id uuid NOT NULL']
  seller_ledger_entry_id "uuid" [not null, note: 'seller_ledger_entry_id uuid NOT NULL']
  allocated_amount "bigint" [not null, note: 'allocated_amount bigint NOT NULL']
  created_at "timestamptz" [not null, note: 'created_at timestamptz NOT NULL DEFAULT now()']
  indexes {
    (settlement_id, seller_ledger_entry_id) [unique]
  }
}

Table settlement.settlement_hold {
  settlement_hold_id "uuid" [not null, pk, note: 'settlement_hold_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  seller_id "uuid" [not null, note: 'seller_id uuid NOT NULL']
  claim_id "uuid" [null, note: 'claim_id uuid']
  source_type "text" [not null, note: 'source_type text NOT NULL']
  source_id "uuid" [null, note: 'source_id uuid']
  source_key "text" [not null, unique, note: 'source_key text NOT NULL']
  amount "bigint" [not null, note: 'amount bigint NOT NULL']
  currency "text" [not null, note: 'currency text NOT NULL']
  reason_code "text" [not null, note: 'reason_code text NOT NULL']
  status "text" [not null, note: 'status text NOT NULL DEFAULT \'ACTIVE\'']
  held_at "timestamptz" [not null, note: 'held_at timestamptz NOT NULL DEFAULT now()']
  release_due_at "timestamptz" [null, note: 'release_due_at timestamptz']
  released_at "timestamptz" [null, note: 'released_at timestamptz']
  release_reason "text" [null, note: 'release_reason text']
  metadata "jsonb" [not null, note: 'metadata jsonb NOT NULL DEFAULT \'{}\'::jsonb']
}

Table settlement.settlement_payout_attempt {
  payout_attempt_id "uuid" [not null, pk, note: 'payout_attempt_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  settlement_id "uuid" [not null, note: 'settlement_id uuid NOT NULL']
  attempt_no "integer" [not null, note: 'attempt_no integer NOT NULL']
  idempotency_key "text" [not null, unique, note: 'idempotency_key text NOT NULL']
  account_snapshot "jsonb" [not null, note: 'account_snapshot jsonb NOT NULL']
  amount "bigint" [not null, note: 'amount bigint NOT NULL']
  currency "text" [not null, note: 'currency text NOT NULL']
  status "text" [not null, note: 'status text NOT NULL DEFAULT \'REQUESTED\'']
  bank_tx_id "text" [null, unique, note: 'bank_tx_id text']
  requested_at "timestamptz" [not null, note: 'requested_at timestamptz NOT NULL DEFAULT now()']
  processed_at "timestamptz" [null, note: 'processed_at timestamptz']
  failure_code "text" [null, note: 'failure_code text']
  failure_message "text" [null, note: 'failure_message text']
  response_payload "jsonb" [not null, note: 'response_payload jsonb NOT NULL DEFAULT \'{}\'::jsonb']
  approval_id "uuid" [not null, note: 'PLANNED approval_id uuid NOT NULL']
  fence_id "uuid" [not null, note: 'PLANNED fence_id uuid NOT NULL']
  dispatch_permit_id "uuid" [null, note: 'PLANNED dispatch_permit_id uuid NULL']
  operation_hash "text" [not null, note: 'PLANNED operation_hash text NOT NULL']
  result_version "bigint" [not null, note: 'PLANNED result_version bigint NOT NULL']
  lease_expires_at "timestamptz" [null, note: 'PLANNED lease_expires_at timestamptz NULL']
  next_retry_at "timestamptz" [null, note: 'PLANNED next_retry_at timestamptz NULL']
  indexes {
    (settlement_id, attempt_no) [unique]
  }
}

Table settlement.reconciliation_file {
  reconciliation_file_id "uuid" [not null, pk, note: 'reconciliation_file_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  provider "text" [not null, note: 'provider text NOT NULL']
  file_type "text" [not null, note: 'file_type text NOT NULL']
  business_date "date" [not null, note: 'business_date date NOT NULL']
  storage_uri "text" [not null, note: 'storage_uri text NOT NULL']
  content_hash "text" [not null, unique, note: 'content_hash text NOT NULL']
  row_count "integer" [not null, note: 'row_count integer NOT NULL']
  control_total "bigint" [null, note: 'control_total bigint']
  currency "text" [null, note: 'currency text']
  received_at "timestamptz" [not null, note: 'received_at timestamptz NOT NULL DEFAULT now()']
  metadata "jsonb" [not null, note: 'metadata jsonb NOT NULL DEFAULT \'{}\'::jsonb']
}

Table settlement.reconciliation_raw_row {
  raw_row_id "uuid" [not null, pk, note: 'raw_row_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  reconciliation_file_id "uuid" [not null, note: 'reconciliation_file_id uuid NOT NULL']
  row_no "integer" [not null, note: 'row_no integer NOT NULL']
  provider_tx_id "text" [null, note: 'provider_tx_id text']
  event_type "text" [null, note: 'event_type text']
  occurred_at "timestamptz" [null, note: 'occurred_at timestamptz']
  gross_amount "bigint" [null, note: 'gross_amount bigint']
  fee_amount "bigint" [null, note: 'fee_amount bigint']
  net_amount "bigint" [null, note: 'net_amount bigint']
  currency "text" [null, note: 'currency text']
  raw_hash "text" [not null, note: 'raw_hash text NOT NULL']
  raw_payload "jsonb" [not null, note: 'raw_payload jsonb NOT NULL']
  ingested_at "timestamptz" [not null, note: 'ingested_at timestamptz NOT NULL DEFAULT now()']
  indexes {
    (reconciliation_file_id, row_no) [unique]
    (reconciliation_file_id, raw_hash) [unique]
  }
}

Table settlement.reconciliation_run {
  reconciliation_run_id "uuid" [not null, pk, note: 'reconciliation_run_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  replay_of_run_id "uuid" [null, note: 'replay_of_run_id uuid']
  run_key "text" [not null, unique, note: 'run_key text NOT NULL']
  run_type "text" [not null, note: 'run_type text NOT NULL']
  business_date_from "date" [not null, note: 'business_date_from date NOT NULL']
  business_date_to "date" [not null, note: 'business_date_to date NOT NULL']
  algorithm_version "text" [not null, note: 'algorithm_version text NOT NULL']
  parameters "jsonb" [not null, note: 'parameters jsonb NOT NULL DEFAULT \'{}\'::jsonb']
  status "text" [not null, note: 'status text NOT NULL DEFAULT \'RUNNING\'']
  started_at "timestamptz" [not null, note: 'started_at timestamptz NOT NULL DEFAULT now()']
  completed_at "timestamptz" [null, note: 'completed_at timestamptz']
  created_by_admin_user_id "uuid" [null, note: 'created_by_admin_user_id uuid']
}

Table settlement.reconciliation_match {
  reconciliation_match_id "uuid" [not null, pk, note: 'reconciliation_match_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  reconciliation_run_id "uuid" [not null, note: 'reconciliation_run_id uuid NOT NULL']
  raw_row_id "uuid" [not null, note: 'raw_row_id uuid NOT NULL']
  payment_transaction_id "uuid" [not null, note: 'payment_transaction_id uuid NOT NULL']
  matched_amount "bigint" [not null, note: 'matched_amount bigint NOT NULL']
  currency "text" [not null, note: 'currency text NOT NULL']
  match_type "text" [not null, note: 'match_type text NOT NULL']
  confidence "numeric(7,6)" [null, note: 'confidence numeric(7,6)']
  match_details "jsonb" [not null, note: 'match_details jsonb NOT NULL DEFAULT \'{}\'::jsonb']
  created_at "timestamptz" [not null, note: 'created_at timestamptz NOT NULL DEFAULT now()']
  indexes {
    (reconciliation_run_id, raw_row_id, payment_transaction_id) [unique]
  }
}

Table settlement.reconciliation_discrepancy {
  discrepancy_id "uuid" [not null, pk, note: 'discrepancy_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  reconciliation_run_id "uuid" [not null, note: 'reconciliation_run_id uuid NOT NULL']
  raw_row_id "uuid" [null, note: 'raw_row_id uuid']
  payment_transaction_id "uuid" [null, note: 'payment_transaction_id uuid']
  supersedes_discrepancy_id "uuid" [null, unique, note: 'supersedes_discrepancy_id uuid']
  discrepancy_group_key "text" [not null, note: 'discrepancy_group_key text NOT NULL']
  version_no "integer" [not null, note: 'version_no integer NOT NULL DEFAULT 1']
  discrepancy_type "text" [not null, note: 'discrepancy_type text NOT NULL']
  expected_amount "bigint" [null, note: 'expected_amount bigint']
  actual_amount "bigint" [null, note: 'actual_amount bigint']
  difference_amount "bigint" [null, note: 'difference_amount bigint']
  currency "text" [null, note: 'currency text']
  status "text" [not null, note: 'status text NOT NULL DEFAULT \'OPEN\'']
  resolution_event "jsonb" [null, note: 'resolution_event jsonb']
  resolved_by_admin_user_id "uuid" [null, note: 'resolved_by_admin_user_id uuid']
  recorded_at "timestamptz" [not null, note: 'recorded_at timestamptz NOT NULL DEFAULT now()']
  resolved_at "timestamptz" [null, note: 'resolved_at timestamptz']
  indexes {
    (discrepancy_group_key, version_no) [unique]
  }
}

Table settlement.bank_deposit_match {
  bank_deposit_match_id "uuid" [not null, pk, note: 'bank_deposit_match_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  reconciliation_run_id "uuid" [not null, note: 'reconciliation_run_id uuid NOT NULL']
  payout_attempt_id "uuid" [not null, note: 'payout_attempt_id uuid NOT NULL']
  raw_row_id "uuid" [not null, note: 'raw_row_id uuid NOT NULL']
  matched_amount "bigint" [not null, note: 'matched_amount bigint NOT NULL']
  currency "text" [not null, note: 'currency text NOT NULL']
  status "text" [not null, note: 'status text NOT NULL DEFAULT \'MATCHED\'']
  matched_at "timestamptz" [not null, note: 'matched_at timestamptz NOT NULL DEFAULT now()']
  matched_by_admin_user_id "uuid" [null, note: 'matched_by_admin_user_id uuid']
  note "text" [null, note: 'note text']
  indexes {
    (reconciliation_run_id, payout_attempt_id, raw_row_id) [unique]
  }
}

Table settlement.outbox_event {
  outbox_event_id "uuid" [not null, pk, note: 'outbox_event_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  event_key "text" [not null, unique, note: 'event_key text NOT NULL']
  aggregate_type "text" [not null, note: 'aggregate_type text NOT NULL']
  aggregate_id "text" [not null, note: 'PLANNED aggregate_id text NOT NULL']
  aggregate_version "bigint" [not null, note: 'PLANNED aggregate_version bigint NOT NULL']
  event_type "text" [not null, note: 'event_type text NOT NULL']
  payload "jsonb" [not null, note: 'payload jsonb NOT NULL']
  status "text" [not null, note: 'status text NOT NULL DEFAULT \'PENDING\'']
  attempt_count "integer" [not null, note: 'attempt_count integer NOT NULL DEFAULT 0']
  occurred_at "timestamptz" [not null, note: 'occurred_at timestamptz NOT NULL DEFAULT now()']
  available_at "timestamptz" [not null, note: 'available_at timestamptz NOT NULL DEFAULT now()']
  published_at "timestamptz" [null, note: 'published_at timestamptz']
  locked_at "timestamptz" [null, note: 'locked_at timestamptz']
  lock_token "uuid" [null, note: 'lock_token uuid']
  last_error "text" [null, note: 'last_error text']
  version "bigint" [not null, note: 'PLANNED version bigint NOT NULL']
  payload_hash "text" [not null, note: 'PLANNED payload_hash text NOT NULL']
  serialized_body "bytea" [not null, note: 'PLANNED serialized_body bytea NOT NULL']
  lease_expires_at "timestamptz" [null, note: 'PLANNED lease_expires_at timestamptz NULL']
  event_version "integer" [not null, note: 'PLANNED event_version integer NOT NULL']
  producer "text" [not null, note: 'PLANNED producer text NOT NULL']
  correlation_id "uuid" [not null, note: 'PLANNED correlation_id uuid NOT NULL']
  causation_id "uuid" [not null, note: 'PLANNED causation_id uuid NOT NULL']
  trace_id "text" [not null, note: 'PLANNED trace_id text NOT NULL']
  indexes {
    (aggregate_type, aggregate_id, aggregate_version) [unique]
  }
}

Table settlement.consumer_inbox {
  consumer_name "text" [not null, note: 'PLANNED consumer_name text NOT NULL']
  event_id "uuid" [not null, note: 'PLANNED event_id uuid NOT NULL']
  entry_id "uuid" [not null, unique, note: 'PLANNED entry_id uuid NOT NULL']
  version "bigint" [not null, note: 'PLANNED version bigint NOT NULL']
  aggregate_type "text" [not null, note: 'PLANNED aggregate_type text NOT NULL']
  aggregate_id "text" [not null, note: 'PLANNED aggregate_id text NOT NULL']
  aggregate_version "bigint" [not null, note: 'PLANNED aggregate_version bigint NOT NULL']
  payload "jsonb" [not null, note: 'PLANNED payload jsonb NOT NULL']
  payload_hash "text" [not null, note: 'PLANNED payload_hash text NOT NULL']
  status "text" [not null, note: 'PLANNED status text NOT NULL']
  attempt_count "integer" [not null, note: 'PLANNED attempt_count integer NOT NULL']
  next_retry_at "timestamptz" [not null, note: 'PLANNED next_retry_at timestamptz NOT NULL']
  lease_token "uuid" [null, note: 'PLANNED lease_token uuid NULL']
  lease_expires_at "timestamptz" [null, note: 'PLANNED lease_expires_at timestamptz NULL']
  received_at "timestamptz" [not null, note: 'PLANNED received_at timestamptz NOT NULL']
  processed_at "timestamptz" [null, note: 'PLANNED processed_at timestamptz NULL']
  indexes {
    (consumer_name, event_id) [pk]
    (consumer_name, aggregate_type, aggregate_id, aggregate_version) [unique]
  }
}

Table settlement.consumer_stream_checkpoint {
  consumer_name "text" [not null, note: 'PLANNED consumer_name text NOT NULL']
  aggregate_type "text" [not null, note: 'PLANNED aggregate_type text NOT NULL']
  aggregate_id "text" [not null, note: 'PLANNED aggregate_id text NOT NULL']
  last_sequence "bigint" [not null, note: 'PLANNED last_sequence bigint NOT NULL']
  blocked_reason "text" [null, note: 'PLANNED blocked_reason text NULL']
  updated_at "timestamptz" [not null, note: 'PLANNED updated_at timestamptz NOT NULL']
  indexes {
    (consumer_name, aggregate_type, aggregate_id) [pk]
  }
}

Table settlement.event_stream_sequence {
  aggregate_type "text" [not null, note: 'PLANNED aggregate_type text NOT NULL']
  aggregate_id "text" [not null, note: 'PLANNED aggregate_id text NOT NULL']
  last_sequence "bigint" [not null, note: 'PLANNED last_sequence bigint NOT NULL']
  version "bigint" [not null, note: 'PLANNED version bigint NOT NULL']
  indexes {
    (aggregate_type, aggregate_id) [pk]
  }
}

Table settlement.event_recovery_job {
  job_id "uuid" [not null, pk, note: 'PLANNED job_id uuid NOT NULL']
  entry_id "uuid" [not null, note: 'PLANNED entry_id uuid NOT NULL']
  queue_type "text" [not null, note: 'PLANNED queue_type text NOT NULL']
  consumer_name "text" [null, note: 'PLANNED consumer_name text NULL']
  event_id "uuid" [not null, note: 'PLANNED event_id uuid NOT NULL']
  expected_hash "text" [not null, note: 'PLANNED expected_hash text NOT NULL']
  source_version "bigint" [not null, note: 'PLANNED source_version bigint NOT NULL']
  status "text" [not null, note: 'PLANNED status text NOT NULL']
  request_hash "text" [not null, note: 'PLANNED request_hash text NOT NULL']
  idempotency_key "text" [not null, note: 'PLANNED idempotency_key text NOT NULL']
  requested_by_admin_id "uuid" [not null, note: 'PLANNED requested_by_admin_id uuid NOT NULL']
  approval_id "uuid" [null, note: 'PLANNED approval_id uuid NULL']
  lease_token "uuid" [null, note: 'PLANNED lease_token uuid NULL']
  lease_expires_at "timestamptz" [null, note: 'PLANNED lease_expires_at timestamptz NULL']
  attempt_count "integer" [not null, note: 'PLANNED attempt_count integer NOT NULL']
  next_retry_at "timestamptz" [not null, note: 'PLANNED next_retry_at timestamptz NOT NULL']
  created_at "timestamptz" [not null, note: 'PLANNED created_at timestamptz NOT NULL']
  completed_at "timestamptz" [null, note: 'PLANNED completed_at timestamptz NULL']
  version "bigint" [not null, note: 'PLANNED version bigint NOT NULL']
  last_error_code "text" [null, note: 'PLANNED last_error_code text NULL']
  indexes {
    (requested_by_admin_id, entry_id, idempotency_key) [unique]
  }
}

Table settlement.seller_recognition_unit {
  recognition_id "uuid" [not null, pk, note: 'PLANNED recognition_id uuid NOT NULL']
  seller_id "uuid" [not null, note: 'PLANNED seller_id uuid NOT NULL']
  order_id "uuid" [not null, note: 'PLANNED order_id uuid NOT NULL']
  source_unit_or_charge_id "text" [not null, note: 'PLANNED source_unit_or_charge_id text NOT NULL']
  source_event_id "uuid" [not null, note: 'PLANNED source_event_id uuid NOT NULL']
  recognized_amount "bigint" [not null, note: 'PLANNED recognized_amount bigint NOT NULL']
  commission_amount "bigint" [not null, note: 'PLANNED commission_amount bigint NOT NULL']
  reversed_amount "bigint" [not null, note: 'PLANNED reversed_amount bigint NOT NULL']
  reversed_fee_amount "bigint" [not null, note: 'PLANNED reversed_fee_amount bigint NOT NULL']
  indexes {
    (seller_id, order_id, source_unit_or_charge_id) [unique]
  }
}

Table settlement.seller_carry_forward {
  carry_forward_id "uuid" [not null, pk, note: 'PLANNED carry_forward_id uuid NOT NULL']
  seller_id "uuid" [not null, note: 'PLANNED seller_id uuid NOT NULL']
  currency "text" [not null, note: 'PLANNED currency text NOT NULL']
  source_settlement_id "uuid" [not null, unique, note: 'PLANNED source_settlement_id uuid NOT NULL']
  signed_amount "bigint" [not null, note: 'PLANNED signed_amount bigint NOT NULL']
  target_settlement_id "uuid" [null, note: 'PLANNED target_settlement_id uuid NULL']
  source_ledger_ids "jsonb" [not null, note: 'PLANNED source_ledger_ids jsonb NOT NULL']
  status "text" [not null, note: 'PLANNED status text NOT NULL']
}

Table settlement.simulated_bank_receipt {
  bank_receipt_id "uuid" [not null, pk, note: 'PLANNED bank_receipt_id uuid NOT NULL']
  idempotency_key "text" [not null, unique, note: 'PLANNED idempotency_key text NOT NULL']
  dispatch_permit_id "uuid" [not null, note: 'PLANNED dispatch_permit_id uuid NOT NULL']
  operation_hash "text" [not null, note: 'PLANNED operation_hash text NOT NULL']
  account_snapshot_hash "text" [not null, note: 'PLANNED account_snapshot_hash text NOT NULL']
  currency "text" [not null, note: 'PLANNED currency text NOT NULL']
  amount "bigint" [not null, note: 'PLANNED amount bigint NOT NULL']
  status "text" [not null, note: 'PLANNED status text NOT NULL']
  occurred_at "timestamptz" [not null, note: 'PLANNED occurred_at timestamptz NOT NULL']
}

Table settlement.bank_reconciliation_run {
  run_id "uuid" [not null, pk, note: 'PLANNED run_id uuid NOT NULL']
  business_date "date" [not null, note: 'PLANNED business_date date NOT NULL']
  source_as_of "timestamptz" [not null, note: 'PLANNED source_as_of timestamptz NOT NULL']
  algorithm_version "text" [not null, note: 'PLANNED algorithm_version text NOT NULL']
  status "text" [not null, note: 'PLANNED status text NOT NULL']
  created_at "timestamptz" [not null, note: 'PLANNED created_at timestamptz NOT NULL']
  completed_at "timestamptz" [null, note: 'PLANNED completed_at timestamptz NULL']
  indexes {
    (business_date, source_as_of, algorithm_version) [unique]
  }
}

Table settlement.bank_reconciliation_receipt {
  bank_receipt_id "uuid" [not null, pk, note: 'PLANNED bank_receipt_id uuid NOT NULL']
  run_id "uuid" [not null, note: 'PLANNED run_id uuid NOT NULL']
  idempotency_key "text" [not null, unique, note: 'PLANNED idempotency_key text NOT NULL']
  account_snapshot_hash "text" [not null, note: 'PLANNED account_snapshot_hash text NOT NULL']
  currency "text" [not null, note: 'PLANNED currency text NOT NULL']
  amount "bigint" [not null, note: 'PLANNED amount bigint NOT NULL']
  status "text" [not null, note: 'PLANNED status text NOT NULL']
  occurred_at "timestamptz" [not null, note: 'PLANNED occurred_at timestamptz NOT NULL']
  receipt "jsonb" [not null, note: 'PLANNED receipt jsonb NOT NULL']
  receipt_hash "text" [not null, note: 'PLANNED receipt_hash text NOT NULL']
}

Table settlement.bank_reconciliation_discrepancy {
  discrepancy_id "uuid" [not null, pk, note: 'PLANNED discrepancy_id uuid NOT NULL']
  run_id "uuid" [not null, note: 'PLANNED run_id uuid NOT NULL']
  identity_key "text" [not null, unique, note: 'PLANNED identity_key text NOT NULL']
  bank_receipt_id "uuid" [null, note: 'PLANNED bank_receipt_id uuid NULL']
  payout_attempt_id "uuid" [null, note: 'PLANNED payout_attempt_id uuid NULL']
  kind "text" [not null, note: 'PLANNED kind text NOT NULL']
  status "text" [not null, note: 'PLANNED status text NOT NULL']
  expected_payload "jsonb" [not null, note: 'PLANNED expected_payload jsonb NOT NULL']
  actual_payload "jsonb" [not null, note: 'PLANNED actual_payload jsonb NOT NULL']
  approval_id "uuid" [null, note: 'PLANNED approval_id uuid NULL']
  resolution_event "jsonb" [null, note: 'PLANNED resolution_event jsonb NULL']
  recorded_at "timestamptz" [not null, note: 'PLANNED recorded_at timestamptz NOT NULL']
  resolved_at "timestamptz" [null, note: 'PLANNED resolved_at timestamptz NULL']
  version "bigint" [not null, note: 'PLANNED version bigint NOT NULL']
}

