Project marketplace {
  database_type: 'PostgreSQL'
  Note: 'Documentation namespaces stand for separate service databases. No cross-service physical FK. CURRENT is migration-derived; PLANNED requires future migrations.'
}

Table commerce.member {
  member_id "uuid" [not null, pk, note: 'member_id uuid DEFAULT gen_random_uuid() NOT NULL']
  email_normalized "text" [not null, unique, note: 'email_normalized text NOT NULL']
  password_hash "text" [null, note: 'password_hash text']
  status "text" [not null, note: 'status text DEFAULT \'ACTIVE\' NOT NULL']
  email_verified_at "timestamptz" [null, note: 'email_verified_at timestamptz']
  last_login_at "timestamptz" [null, note: 'last_login_at timestamptz']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz DEFAULT now() NOT NULL']
  withdrawn_at "timestamptz" [null, note: 'withdrawn_at timestamptz']
}

Table commerce.member_auth_identity {
  auth_identity_id "uuid" [not null, pk, note: 'auth_identity_id uuid DEFAULT gen_random_uuid() NOT NULL']
  member_id "uuid" [not null, note: 'member_id uuid NOT NULL']
  provider "text" [not null, note: 'provider text NOT NULL']
  provider_subject "text" [not null, note: 'provider_subject text NOT NULL']
  credential_hash "text" [null, note: 'credential_hash text']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  last_authenticated_at "timestamptz" [null, note: 'last_authenticated_at timestamptz']
  revoked_at "timestamptz" [null, note: 'revoked_at timestamptz']
  indexes {
    (provider, provider_subject) [unique]
  }
}

Table commerce.member_profile {
  member_id "uuid" [not null, pk, note: 'member_id uuid DEFAULT gen_random_uuid() NOT NULL']
  gender "text" [not null, note: 'gender text DEFAULT \'UNDISCLOSED\' NOT NULL']
  birth_date "date" [null, note: 'birth_date date']
  height_cm "numeric(5,2)" [null, note: 'height_cm numeric(5,2)']
  weight_kg "numeric(6,2)" [null, note: 'weight_kg numeric(6,2)']
  recommendation_consent "boolean" [not null, note: 'recommendation_consent boolean DEFAULT false NOT NULL']
  recommendation_consent_version "text" [null, note: 'recommendation_consent_version text']
  recommendation_consented_at "timestamptz" [null, note: 'recommendation_consented_at timestamptz']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz DEFAULT now() NOT NULL']
}

Table commerce.shipping_address {
  address_id "uuid" [not null, pk, note: 'address_id uuid DEFAULT gen_random_uuid() NOT NULL']
  member_id "uuid" [not null, note: 'member_id uuid NOT NULL']
  address_label "text" [null, note: 'address_label text']
  recipient_name "text" [not null, note: 'recipient_name text NOT NULL']
  phone_cipher "bytea" [not null, note: 'phone_cipher bytea NOT NULL']
  postal_code "text" [null, note: 'postal_code text']
  address_cipher "bytea" [not null, note: 'address_cipher bytea NOT NULL']
  delivery_note_cipher "bytea" [null, note: 'delivery_note_cipher bytea']
  status "text" [not null, note: 'status text DEFAULT \'ACTIVE\' NOT NULL']
  is_default "boolean" [not null, note: 'is_default boolean DEFAULT false NOT NULL']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz DEFAULT now() NOT NULL']
  deleted_at "timestamptz" [null, note: 'deleted_at timestamptz']
}

Table commerce.seller {
  seller_id "uuid" [not null, pk, note: 'seller_id uuid DEFAULT gen_random_uuid() NOT NULL']
  business_number "text" [not null, unique, note: 'business_number text NOT NULL']
  legal_name "text" [not null, note: 'legal_name text NOT NULL']
  display_name "text" [not null, note: 'display_name text NOT NULL']
  business_type "text" [not null, note: 'business_type text NOT NULL']
  seller_status "text" [not null, note: 'seller_status text DEFAULT \'ONBOARDING\' NOT NULL']
  opened_at "timestamptz" [null, note: 'opened_at timestamptz']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz DEFAULT now() NOT NULL']
  closed_at "timestamptz" [null, note: 'closed_at timestamptz']
}

Table commerce.seller_member {
  seller_member_id "uuid" [not null, pk, note: 'seller_member_id uuid DEFAULT gen_random_uuid() NOT NULL']
  seller_id "uuid" [not null, note: 'seller_id uuid NOT NULL']
  member_id "uuid" [not null, note: 'member_id uuid NOT NULL']
  role "text" [not null, note: 'role text NOT NULL']
  status "text" [not null, note: 'status text DEFAULT \'INVITED\' NOT NULL']
  invited_at "timestamptz" [not null, note: 'invited_at timestamptz DEFAULT now() NOT NULL']
  joined_at "timestamptz" [null, note: 'joined_at timestamptz']
  left_at "timestamptz" [null, note: 'left_at timestamptz']
  indexes {
    (seller_id, member_id) [unique]
  }
}

Table commerce.seller_document {
  document_id "uuid" [not null, pk, note: 'document_id uuid DEFAULT gen_random_uuid() NOT NULL']
  seller_id "uuid" [not null, note: 'seller_id uuid NOT NULL']
  document_type "text" [not null, note: 'document_type text NOT NULL']
  file_url "text" [not null, note: 'file_url text NOT NULL']
  content_hash "text" [not null, note: 'content_hash text NOT NULL']
  retention_class "text" [not null, note: 'retention_class text NOT NULL']
  status "text" [not null, note: 'status text DEFAULT \'ACTIVE\' NOT NULL']
  issued_at "date" [null, note: 'issued_at date']
  expires_at "timestamptz" [null, note: 'expires_at timestamptz']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  deleted_at "timestamptz" [null, note: 'deleted_at timestamptz']
}

Table commerce.seller_verification {
  verification_id "uuid" [not null, pk, note: 'verification_id uuid DEFAULT gen_random_uuid() NOT NULL']
  seller_id "uuid" [not null, note: 'seller_id uuid NOT NULL']
  document_id "uuid" [null, note: 'document_id uuid']
  verification_request_key "text" [not null, unique, note: 'verification_request_key text NOT NULL']
  verification_type "text" [not null, note: 'verification_type text NOT NULL']
  provider "text" [null, note: 'provider text']
  status "text" [not null, note: 'status text DEFAULT \'REQUESTED\' NOT NULL']
  result_hash "text" [null, note: 'result_hash text']
  result_snapshot "jsonb" [not null, note: 'result_snapshot jsonb DEFAULT \'{}\'::jsonb NOT NULL']
  requested_at "timestamptz" [not null, note: 'requested_at timestamptz DEFAULT now() NOT NULL']
  verified_at "timestamptz" [null, note: 'verified_at timestamptz']
  expires_at "timestamptz" [null, note: 'expires_at timestamptz']
}

Table commerce.seller_settlement_account {
  account_id "uuid" [not null, pk, note: 'account_id uuid DEFAULT gen_random_uuid() NOT NULL']
  seller_id "uuid" [not null, note: 'seller_id uuid NOT NULL']
  bank_code "text" [not null, note: 'bank_code text NOT NULL']
  account_cipher "bytea" [not null, note: 'account_cipher bytea NOT NULL']
  account_fingerprint "text" [not null, note: 'account_fingerprint text NOT NULL']
  holder_name_cipher "bytea" [not null, note: 'holder_name_cipher bytea NOT NULL']
  verification_status "text" [not null, note: 'verification_status text DEFAULT \'PENDING\' NOT NULL']
  status "text" [not null, note: 'status text DEFAULT \'PENDING\' NOT NULL']
  is_default "boolean" [not null, note: 'is_default boolean DEFAULT false NOT NULL']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  verified_at "timestamptz" [null, note: 'verified_at timestamptz']
  deactivated_at "timestamptz" [null, note: 'deactivated_at timestamptz']
  indexes {
    (seller_id, account_fingerprint) [unique]
  }
}

Table commerce.brand {
  brand_id "uuid" [not null, pk, note: 'brand_id uuid DEFAULT gen_random_uuid() NOT NULL']
  brand_name "text" [not null, note: 'brand_name text NOT NULL']
  brand_name_normalized "text" [not null, unique, note: 'brand_name_normalized text NOT NULL']
  status "text" [not null, note: 'status text DEFAULT \'ACTIVE\' NOT NULL']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz DEFAULT now() NOT NULL']
}

Table commerce.seller_brand_relation {
  seller_brand_relation_id "uuid" [not null, pk, note: 'seller_brand_relation_id uuid DEFAULT gen_random_uuid() NOT NULL']
  seller_id "uuid" [not null, note: 'seller_id uuid NOT NULL']
  brand_id "uuid" [not null, note: 'brand_id uuid NOT NULL']
  relation_type "text" [not null, note: 'relation_type text NOT NULL']
  verification_status "text" [not null, note: 'verification_status text DEFAULT \'PENDING\' NOT NULL']
  evidence_snapshot "jsonb" [not null, note: 'evidence_snapshot jsonb DEFAULT \'{}\'::jsonb NOT NULL']
  valid_from "timestamptz" [null, note: 'valid_from timestamptz']
  valid_to "timestamptz" [null, note: 'valid_to timestamptz']
  approved_at "timestamptz" [null, note: 'approved_at timestamptz']
  revoked_at "timestamptz" [null, note: 'revoked_at timestamptz']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz DEFAULT now() NOT NULL']
  indexes {
    (seller_id, brand_id) [unique]
  }
}

Table commerce.brand_registration_request {
  request_id "uuid" [not null, pk, note: 'request_id uuid DEFAULT gen_random_uuid() NOT NULL']
  seller_id "uuid" [not null, note: 'seller_id uuid NOT NULL']
  requested_name "text" [not null, note: 'requested_name text NOT NULL']
  requested_name_normalized "text" [not null, note: 'requested_name_normalized text NOT NULL']
  request_snapshot "jsonb" [not null, note: 'request_snapshot jsonb DEFAULT \'{}\'::jsonb NOT NULL']
  status "text" [not null, note: 'status text DEFAULT \'REQUESTED\' NOT NULL']
  approved_brand_id "uuid" [null, note: 'approved_brand_id uuid']
  reviewed_by_admin_user_id "uuid" [null, note: 'reviewed_by_admin_user_id uuid']
  requested_at "timestamptz" [not null, note: 'requested_at timestamptz DEFAULT now() NOT NULL']
  reviewed_at "timestamptz" [null, note: 'reviewed_at timestamptz']
  review_note "text" [null, note: 'review_note text']
}

Table commerce.category {
  category_id "uuid" [not null, pk, note: 'category_id uuid DEFAULT gen_random_uuid() NOT NULL']
  parent_category_id "uuid" [null, note: 'parent_category_id uuid']
  category_code "text" [not null, unique, note: 'category_code text NOT NULL']
  category_name "text" [not null, note: 'category_name text NOT NULL']
  category_name_normalized "text" [not null, note: 'category_name_normalized text NOT NULL']
  is_leaf "boolean" [not null, note: 'is_leaf boolean DEFAULT true NOT NULL']
  status "text" [not null, note: 'status text DEFAULT \'ACTIVE\' NOT NULL']
  display_order "integer" [not null, note: 'display_order integer DEFAULT 0 NOT NULL']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz DEFAULT now() NOT NULL']
}

Table commerce.product {
  product_id "uuid" [not null, pk, note: 'product_id uuid DEFAULT gen_random_uuid() NOT NULL']
  seller_brand_relation_id "uuid" [not null, note: 'seller_brand_relation_id uuid NOT NULL']
  category_id "uuid" [not null, note: 'category_id uuid NOT NULL']
  seller_product_code "text" [null, note: 'seller_product_code text']
  sale_status "text" [not null, note: 'sale_status text DEFAULT \'DRAFT\' NOT NULL']
  current_revision_no "integer" [null, note: 'current_revision_no integer']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz DEFAULT now() NOT NULL']
  published_at "timestamptz" [null, note: 'published_at timestamptz']
  archived_at "timestamptz" [null, note: 'archived_at timestamptz']
  indexes {
    (seller_brand_relation_id, seller_product_code) [unique]
  }
}

Table commerce.product_revision {
  product_revision_id "uuid" [not null, pk, note: 'product_revision_id uuid DEFAULT gen_random_uuid() NOT NULL']
  product_id "uuid" [not null, note: 'product_id uuid NOT NULL']
  revision_no "integer" [not null, note: 'revision_no integer NOT NULL']
  product_name "text" [not null, note: 'product_name text NOT NULL']
  description "text" [null, note: 'description text']
  primary_image_id "uuid" [null, note: 'primary_image_id uuid']
  attributes_snapshot "jsonb" [not null, note: 'attributes_snapshot jsonb DEFAULT \'{}\'::jsonb NOT NULL']
  created_by_seller_member_id "uuid" [null, note: 'created_by_seller_member_id uuid']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  published_at "timestamptz" [null, note: 'published_at timestamptz']
  indexes {
    (product_id, revision_no) [unique]
  }
}

Table commerce.product_image {
  image_id "uuid" [not null, pk, note: 'image_id uuid DEFAULT gen_random_uuid() NOT NULL']
  product_id "uuid" [not null, note: 'product_id uuid NOT NULL']
  image_type "text" [not null, note: 'image_type text NOT NULL']
  image_url "text" [not null, note: 'image_url text NOT NULL']
  alt_text "text" [null, note: 'alt_text text']
  content_hash "text" [null, note: 'content_hash text']
  display_order "integer" [not null, note: 'display_order integer DEFAULT 0 NOT NULL']
  status "text" [not null, note: 'status text DEFAULT \'ACTIVE\' NOT NULL']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  deleted_at "timestamptz" [null, note: 'deleted_at timestamptz']
  indexes {
    (product_id, image_id) [unique]
  }
}

Table commerce.product_feature {
  feature_id "uuid" [not null, pk, note: 'feature_id uuid DEFAULT gen_random_uuid() NOT NULL']
  product_revision_id "uuid" [not null, note: 'product_revision_id uuid NOT NULL']
  feature_order "integer" [not null, note: 'feature_order integer NOT NULL']
  feature_text "text" [not null, note: 'feature_text text NOT NULL']
  source_type "text" [not null, note: 'source_type text NOT NULL']
  source_snapshot "jsonb" [not null, note: 'source_snapshot jsonb DEFAULT \'{}\'::jsonb NOT NULL']
  confirmed_by_seller "boolean" [not null, note: 'confirmed_by_seller boolean DEFAULT false NOT NULL']
  confirmed_by_seller_member_id "uuid" [null, note: 'confirmed_by_seller_member_id uuid']
  confirmed_at "timestamptz" [null, note: 'confirmed_at timestamptz']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  indexes {
    (product_revision_id, feature_order) [unique]
  }
}

Table commerce.option_group {
  option_group_id "uuid" [not null, pk, note: 'option_group_id uuid DEFAULT gen_random_uuid() NOT NULL']
  product_id "uuid" [not null, note: 'product_id uuid NOT NULL']
  group_code "text" [not null, note: 'group_code text NOT NULL']
  display_name "text" [not null, note: 'display_name text NOT NULL']
  display_order "integer" [not null, note: 'display_order integer DEFAULT 0 NOT NULL']
  is_required "boolean" [not null, note: 'is_required boolean DEFAULT true NOT NULL']
  status "text" [not null, note: 'status text DEFAULT \'ACTIVE\' NOT NULL']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz DEFAULT now() NOT NULL']
  indexes {
    (product_id, group_code) [unique]
    (product_id, option_group_id) [unique]
  }
}

Table commerce.option_value {
  option_value_id "uuid" [not null, pk, note: 'option_value_id uuid DEFAULT gen_random_uuid() NOT NULL']
  option_group_id "uuid" [not null, note: 'option_group_id uuid NOT NULL']
  value_code "text" [not null, note: 'value_code text NOT NULL']
  display_name "text" [not null, note: 'display_name text NOT NULL']
  display_order "integer" [not null, note: 'display_order integer DEFAULT 0 NOT NULL']
  value_metadata "jsonb" [not null, note: 'value_metadata jsonb DEFAULT \'{}\'::jsonb NOT NULL']
  status "text" [not null, note: 'status text DEFAULT \'ACTIVE\' NOT NULL']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz DEFAULT now() NOT NULL']
  indexes {
    (option_group_id, value_code) [unique]
    (option_group_id, option_value_id) [unique]
  }
}

Table commerce.sku {
  sku_id "uuid" [not null, pk, note: 'sku_id uuid DEFAULT gen_random_uuid() NOT NULL']
  product_id "uuid" [not null, note: 'product_id uuid NOT NULL']
  seller_sku_code "text" [not null, note: 'seller_sku_code text NOT NULL']
  combination_key "text" [not null, note: 'combination_key text NOT NULL']
  sale_price "bigint" [not null, note: 'sale_price bigint NOT NULL']
  currency "char(3)" [not null, note: 'currency char(3) DEFAULT \'KRW\' NOT NULL']
  sku_status "text" [not null, note: 'sku_status text DEFAULT \'DRAFT\' NOT NULL']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz DEFAULT now() NOT NULL']
  archived_at "timestamptz" [null, note: 'archived_at timestamptz']
  indexes {
    (product_id, seller_sku_code) [unique]
    (product_id, combination_key) [unique]
    (product_id, sku_id) [unique]
  }
}

Table commerce.sku_option_value {
  sku_option_value_id "uuid" [not null, pk, note: 'sku_option_value_id uuid DEFAULT gen_random_uuid() NOT NULL']
  product_id "uuid" [not null, note: 'product_id uuid NOT NULL']
  sku_id "uuid" [not null, note: 'sku_id uuid NOT NULL']
  option_group_id "uuid" [not null, note: 'option_group_id uuid NOT NULL']
  option_value_id "uuid" [not null, note: 'option_value_id uuid NOT NULL']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
  indexes {
    (sku_id, option_group_id) [unique]
  }
}

Table commerce.inventory {
  sku_id "uuid" [not null, pk, note: 'sku_id uuid DEFAULT gen_random_uuid() NOT NULL']
  on_hand_qty "integer" [not null, note: 'on_hand_qty integer DEFAULT 0 NOT NULL']
  reserved_qty "integer" [not null, note: 'reserved_qty integer DEFAULT 0 NOT NULL']
  safety_stock_qty "integer" [not null, note: 'safety_stock_qty integer DEFAULT 0 NOT NULL']
  available_qty "integer" [null, note: 'available_qty integer GENERATED ALWAYS AS (         on_hand_qty - reserved_qty - safety_stock_qty     ) STORED']
  version "integer" [not null, note: 'version integer DEFAULT 0 NOT NULL']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz DEFAULT now() NOT NULL']
}

Table commerce.inventory_ledger {
  inventory_ledger_id "uuid" [not null, pk, note: 'inventory_ledger_id uuid DEFAULT gen_random_uuid() NOT NULL']
  sku_id "uuid" [not null, note: 'sku_id uuid NOT NULL']
  quantity_type "text" [not null, note: 'quantity_type text NOT NULL']
  signed_delta "integer" [not null, note: 'signed_delta integer NOT NULL']
  balance_after "integer" [not null, note: 'balance_after integer NOT NULL']
  reason_type "text" [not null, note: 'reason_type text NOT NULL']
  reference_type "text" [not null, note: 'reference_type text NOT NULL']
  reference_key "text" [not null, unique, note: 'reference_key text NOT NULL']
  source_snapshot "jsonb" [not null, note: 'source_snapshot jsonb DEFAULT \'{}\'::jsonb NOT NULL']
  occurred_at "timestamptz" [not null, note: 'occurred_at timestamptz DEFAULT now() NOT NULL']
  created_at "timestamptz" [not null, note: 'created_at timestamptz DEFAULT now() NOT NULL']
}

Table commerce.cart {
  cart_id "uuid" [not null, pk, note: 'cart_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  member_id "uuid" [not null, note: 'member_id uuid NOT NULL']
  status "text" [not null, note: 'status text NOT NULL DEFAULT \'ACTIVE\'']
  version "integer" [not null, note: 'version integer NOT NULL DEFAULT 0']
  expires_at "timestamptz" [null, note: 'expires_at timestamptz']
  created_at "timestamptz" [not null, note: 'created_at timestamptz NOT NULL DEFAULT now()']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz NOT NULL DEFAULT now()']
}

Table commerce.cart_item {
  cart_item_id "uuid" [not null, pk, note: 'cart_item_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  cart_id "uuid" [not null, note: 'cart_id uuid NOT NULL']
  sku_id "uuid" [not null, note: 'sku_id uuid NOT NULL']
  quantity "integer" [not null, note: 'quantity integer NOT NULL']
  selected "boolean" [not null, note: 'selected boolean NOT NULL DEFAULT true']
  price_display_cache "bigint" [null, note: 'price_display_cache bigint']
  currency "varchar(3)" [null, note: 'currency varchar(3)']
  added_at "timestamptz" [not null, note: 'added_at timestamptz NOT NULL DEFAULT now()']
  updated_at "timestamptz" [not null, note: 'updated_at timestamptz NOT NULL DEFAULT now()']
  indexes {
    (cart_id, sku_id) [unique]
  }
}

Table commerce.checkout {
  checkout_id "uuid" [not null, pk, note: 'checkout_id uuid PRIMARY KEY DEFAULT gen_random_uuid()']
  member_id "uuid" [not null, note: 'member_id uuid NOT NULL']
  cart_id "uuid" [null, note: 'cart_id uuid']
  idempotency_key "text" [not null, note: 'idempotency_key text NOT NULL']
  status "text" [not null, note: 'status text NOT NULL DEFAULT \'OPEN\'']
  currency "varchar(3)" [not null, note: 'currency varchar(3) NOT NULL']
  item_subtotal_amount "bigint" [not null, note: 'item_subtotal_amount bigint NOT NULL DEFAULT 0']
  discount_amount "bigint" [not null, note: 'discount_amount bigint NOT NULL DEFAULT 0']
  shipping_amount "bigint" [not null, note: 'shipping_amount bigint NOT NULL DEFAULT 0']
  tax_amount "bigint" [not null, note: 'tax_amount bigint NOT NULL DEFAULT 0']
  payable_amount "bigint" [not null, note: 'payable_amount bigint NOT NULL DEFAULT 0']
  pricing_snapshot "jsonb" [not null, note: 'pricing_snapshot jsonb NOT NULL DEFAULT \'{}\'::jsonb']
  shipping_address_snapshot "jsonb" [not null, note: 'shipping_address_snapshot jsonb NOT NULL DEFAULT \'{}\'::jsonb']
  version "integer" [not null, note: 'version integer NOT NULL DEFAULT 0']
  expires_at "timestamptz" [not null, note: 'expires_at timestamptz NOT NULL']
  created_at "timestamptz" [not null, note: 'created_at timestamptz NOT NULL DEFAULT now()']
