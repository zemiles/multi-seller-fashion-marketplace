Ref commerce_fk_member_auth_identity_member: commerce.member_auth_identity.member_id > commerce.member.member_id
Ref commerce_fk_member_profile_member: commerce.member_profile.member_id - commerce.member.member_id
Ref commerce_fk_shipping_address_member: commerce.shipping_address.member_id > commerce.member.member_id
Ref commerce_fk_seller_member_seller: commerce.seller_member.seller_id > commerce.seller.seller_id
Ref commerce_fk_seller_member_member: commerce.seller_member.member_id > commerce.member.member_id
Ref commerce_fk_seller_document_seller: commerce.seller_document.seller_id > commerce.seller.seller_id
Ref commerce_fk_seller_verification_seller: commerce.seller_verification.seller_id > commerce.seller.seller_id
Ref commerce_fk_seller_verification_document: commerce.seller_verification.document_id > commerce.seller_document.document_id
Ref commerce_fk_seller_settlement_account_seller: commerce.seller_settlement_account.seller_id > commerce.seller.seller_id
Ref commerce_fk_seller_brand_relation_seller: commerce.seller_brand_relation.seller_id > commerce.seller.seller_id
Ref commerce_fk_seller_brand_relation_brand: commerce.seller_brand_relation.brand_id > commerce.brand.brand_id
Ref commerce_fk_brand_registration_request_seller: commerce.brand_registration_request.seller_id > commerce.seller.seller_id
Ref commerce_fk_brand_registration_request_approved_brand: commerce.brand_registration_request.approved_brand_id > commerce.brand.brand_id
Ref commerce_fk_brand_registration_request_reviewer: commerce.brand_registration_request.reviewed_by_admin_user_id > commerce.admin_user.admin_user_id
Ref commerce_fk_category_parent: commerce.category.parent_category_id > commerce.category.category_id
Ref commerce_fk_product_seller_brand_relation: commerce.product.seller_brand_relation_id > commerce.seller_brand_relation.seller_brand_relation_id
Ref commerce_fk_product_category: commerce.product.category_id > commerce.category.category_id
Ref commerce_fk_product_revision_product: commerce.product_revision.product_id > commerce.product.product_id
Ref commerce_fk_product_image_product: commerce.product_image.product_id > commerce.product.product_id
Ref commerce_fk_product_revision_primary_image: commerce.product_revision.(product_id, primary_image_id) > commerce.product_image.(product_id, image_id)
Ref commerce_fk_product_current_revision: commerce.product.(product_id, current_revision_no) - commerce.product_revision.(product_id, revision_no)
Ref commerce_fk_product_revision_creator: commerce.product_revision.created_by_seller_member_id > commerce.seller_member.seller_member_id
Ref commerce_fk_product_feature_revision: commerce.product_feature.product_revision_id > commerce.product_revision.product_revision_id
Ref commerce_fk_product_feature_confirmer: commerce.product_feature.confirmed_by_seller_member_id > commerce.seller_member.seller_member_id
Ref commerce_fk_option_group_product: commerce.option_group.product_id > commerce.product.product_id
Ref commerce_fk_option_value_group: commerce.option_value.option_group_id > commerce.option_group.option_group_id
Ref commerce_fk_sku_product: commerce.sku.product_id > commerce.product.product_id
Ref commerce_fk_sku_option_value_sku: commerce.sku_option_value.(product_id, sku_id) > commerce.sku.(product_id, sku_id)
Ref commerce_fk_sku_option_value_group: commerce.sku_option_value.(product_id, option_group_id) > commerce.option_group.(product_id, option_group_id)
Ref commerce_fk_sku_option_value_value: commerce.sku_option_value.(option_group_id, option_value_id) > commerce.option_value.(option_group_id, option_value_id)
Ref commerce_fk_inventory_sku: commerce.inventory.sku_id - commerce.sku.sku_id
Ref commerce_fk_inventory_ledger_inventory: commerce.inventory_ledger.sku_id > commerce.inventory.sku_id
Ref commerce_cart_member_fk: commerce.cart.member_id > commerce.member.member_id
Ref commerce_cart_item_cart_fk: commerce.cart_item.cart_id > commerce.cart.cart_id
Ref commerce_cart_item_sku_fk: commerce.cart_item.sku_id > commerce.sku.sku_id
Ref commerce_checkout_member_fk: commerce.checkout.member_id > commerce.member.member_id
Ref commerce_checkout_cart_fk: commerce.checkout.cart_id > commerce.cart.cart_id
Ref commerce_checkout_shipping_group_checkout_fk: commerce.checkout_shipping_group.checkout_id > commerce.checkout.checkout_id
Ref commerce_checkout_shipping_group_seller_fk: commerce.checkout_shipping_group.seller_id > commerce.seller.seller_id
Ref commerce_checkout_item_checkout_fk: commerce.checkout_item.checkout_id > commerce.checkout.checkout_id
Ref commerce_checkout_item_shipping_group_fk: commerce.checkout_item.checkout_shipping_group_id > commerce.checkout_shipping_group.checkout_shipping_group_id
Ref commerce_checkout_item_sku_fk: commerce.checkout_item.sku_id > commerce.sku.sku_id
Ref commerce_checkout_item_product_revision_fk: commerce.checkout_item.product_revision_id > commerce.product_revision.product_revision_id
Ref commerce_inventory_reservation_checkout_fk: commerce.inventory_reservation.checkout_id - commerce.checkout.checkout_id
Ref commerce_inventory_reservation_item_reservation_fk: commerce.inventory_reservation_item.reservation_id > commerce.inventory_reservation.reservation_id
Ref commerce_inventory_reservation_item_sku_fk: commerce.inventory_reservation_item.sku_id > commerce.sku.sku_id
Ref commerce_orders_checkout_fk: commerce.orders.checkout_id - commerce.checkout.checkout_id
Ref commerce_orders_member_fk: commerce.orders.member_id > commerce.member.member_id
Ref commerce_order_shipping_group_order_fk: commerce.order_shipping_group.order_id > commerce.orders.order_id
Ref commerce_order_shipping_group_checkout_group_fk: commerce.order_shipping_group.checkout_shipping_group_id - commerce.checkout_shipping_group.checkout_shipping_group_id
Ref commerce_order_shipping_group_seller_fk: commerce.order_shipping_group.seller_id > commerce.seller.seller_id
Ref commerce_order_item_order_fk: commerce.order_item.order_id > commerce.orders.order_id
