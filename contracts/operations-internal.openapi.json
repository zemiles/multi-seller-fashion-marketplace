{
  "openapi": "3.1.0",
  "info": {
    "title": "업무 서비스 공통 운영 내부 API",
    "version": "1.0.0",
    "description": "Commerce/Payment/Settlement/Discovery 각각의 로컬 queue/recovery port 계약. 별도 서비스를 추가하지 않습니다. 각 서버 aud는 실제 서비스 ID이며 Commerce만 사용자 대리를 허용합니다."
  },
  "x-owner-service": "business-service",
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "commerce-service own DB only",
      "x-jwt-audience": "commerce-service"
    },
    {
      "url": "http://localhost:8082",
      "description": "payment-service own DB only",
      "x-jwt-audience": "payment-service"
    },
    {
      "url": "http://localhost:8083",
      "description": "settlement-service own DB only",
      "x-jwt-audience": "settlement-service"
    },
    {
      "url": "http://localhost:8084",
      "description": "discovery-data-service own DB only",
      "x-jwt-audience": "discovery-data-service"
    }
  ],
