  "components": {
    "schemas": {
      "PgApprove": {
        "type": "object",
        "properties": {
          "merchantTxId": {
            "type": "string",
            "pattern": "\\S"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "amount": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "merchantTxId",
          "currency",
          "amount",
          "idempotencyKey"
        ]
      },
      "PgCancel": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "idempotencyKey"
        ]
      },
      "PgRefund": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "amount",
          "idempotencyKey"
        ]
      },
      "PgPayment": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "merchantTxId": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "amount": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "APPROVED",
              "CANCELLED",
              "PARTIALLY_REFUNDED",
              "REFUNDED"
            ]
          },
          "refundedAmount": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "paymentId",
          "merchantTxId",
          "currency",
          "amount",
          "status",
          "refundedAmount"
        ]
      },
      "PgError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "code",
          "message",
          "timestamp",
          "path"
        ]
      }
    },
    "securitySchemes": {}
  }
}
