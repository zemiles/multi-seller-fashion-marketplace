  "components": {
    "schemas": {
      "PgApprove": {
        "type": "object",
        "properties": {
          "merchantTxId": {
            "type": "string",
            "pattern": "\\S"
          },
          "currency": {
            "type": "string",
            "const": "KRW"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "merchantTxId",
          "currency",
          "amount",
          "idempotencyKey"
        ]
      },
      "PgCancel": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "idempotencyKey"
        ]
      },
      "PgRefund": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "idempotencyKey": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "amount",
          "idempotencyKey"
        ]
      },
      "PgPayment": {
        "type": "object",
        "properties": {
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "merchantTxId": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "const": "KRW"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "status": {
            "type": "string",
            "enum": [
              "APPROVED",
              "CANCELLED",
              "PARTIALLY_REFUNDED",
              "REFUNDED"
            ]
          },
          "refundedAmount": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "simulated": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "paymentId",
          "merchantTxId",
          "currency",
          "amount",
          "status",
          "refundedAmount",
          "simulated"
        ]
      },
      "PgError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "code",
          "message",
          "timestamp",
          "path"
        ]
      },
      "PgReceipt": {
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string",
            "format": "uuid"
          },
          "paymentId": {
            "type": "string",
            "format": "uuid"
          },
          "merchantTxId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "transactionType": {
            "type": "string",
            "enum": [
              "APPROVE",
              "CANCEL",
              "REFUND"
            ]
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "currency": {
            "type": "string",
            "const": "KRW"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUCCEEDED",
              "FAILED"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "simulated": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "transactionId",
          "paymentId",
          "merchantTxId",
          "transactionType",
          "idempotencyKey",
          "amount",
          "currency",
          "status",
          "occurredAt",
          "simulated"
        ],
        "additionalProperties": false
      },
      "PgReceiptPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PgReceipt"
            },
            "minItems": 0,
            "maxItems": 100
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              {
                "type": "null"
              }
            ]
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "items",
          "nextCursor",
          "asOf"
        ],
        "additionalProperties": false
      },
      "PgFault": {
        "type": "object",
        "properties": {
          "scenarioId": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "BEFORE_COMMIT_ERROR",
              "AFTER_COMMIT_DROP_RESPONSE",
              "DELAY_RESPONSE",
              "DUPLICATE_WEBHOOK",
              "OUT_OF_ORDER_WEBHOOK",
              "INVALID_SIGNATURE"
            ]
          },
          "remainingUses": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "delayMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30000
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "scenarioId",
          "type",
          "remainingUses",
          "delayMs",
          "expiresAt"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "serviceJWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "RS256, allowlisted iss/sub, service audience, 60-second exp, operation scopes. Never browser credentials."
      }
    }
  }
}
