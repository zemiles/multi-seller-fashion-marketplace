              "minLength": 1,
              "maxLength": 2048
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "읽기 전용 확정 사실. from 포함/to 제외, asOf/cursor 고정.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PgReceiptPage"
                },
                "example": {
